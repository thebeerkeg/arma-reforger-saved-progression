# Used by docker-compose. Copy to `.env` before bringing the stack up.

# --- Postgres profile (--profile postgres) -----------------------------------
# The password here must match the one in config.toml's postgres_url.
POSTGRES_USER=tbk
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tbk_progression

# --- HTTPS profile (--profile https) ----------------------------------------
# Real address you actually read — Let's Encrypt uses it to warn you about
# expiring certs and other issues with your account.
CERTBOT_EMAIL=you@example.com
